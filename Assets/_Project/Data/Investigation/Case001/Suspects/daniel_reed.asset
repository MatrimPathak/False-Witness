  portrait: {fileID: 0}
  statements:
  - statementId: daniel_01
    text: I was helping Mrs. Wilson with her luggage around 10:15.
    associatedFact: {fileID: 11400000, guid: 5aab8f21be41f4ff489f9a8084f20a90, type: 2}
  - statementId: daniel_02
    text: I didn't enter the service corridor after 10 PM.
    associatedFact: {fileID: 11400000, guid: 422a238e7832d47f88ab2fef266afe75, type: 2}
  - statementId: daniel_03
    text: I never went into Arthur's office that night.
    associatedFact: {fileID: 11400000, guid: eac1dc89d9901462fa33e810c917bc12, type: 2}
